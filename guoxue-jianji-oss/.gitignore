# 第三方模型权重：体积大，且上游限非商业，不随仓库分发
*.pth
*.pt
*.ckpt
*.onnx
*.safetensors

# 运行时产物与缓存
__pycache__/
*.py[cod]
.DS_Store
*.tmp
vendor/bin/ffmpeg
vendor/wav2lip/temp/*
!vendor/wav2lip/temp/.gitkeep
vendor/wav2lip/results/*
!vendor/wav2lip/results/.gitkeep

# 长台词兜底素材（运行时由 ffmpeg 动态生成，无需入库）
assets/shots/*_loop.mp4

# 本地输出
out/
*.log
